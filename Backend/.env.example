# ═══════════════════════════════════════════════════════════════════
#  BurnoutShield Backend — Environment Variables
#
#  Copy this file to Backend/.env for local development.
#  For Railway deployment, add these in the Railway dashboard
#  under your service → Variables tab. DO NOT commit .env to git.
#
#  Generate SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ═══════════════════════════════════════════════════════════════════

# ── Security (REQUIRED) ───────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
TOKEN_EXPIRE_DAYS=7

# ── MongoDB (REQUIRED) ────────────────────────────────────────────

# Local development (no Docker):
MONGO_URI=mongodb://localhost:27017

# Docker (docker-compose sets this automatically):
# MONGO_URI=mongodb://admin:changeme123@mongo:27017/burnoutshield?authSource=admin

# MongoDB Atlas — use this for Railway/production:
# 1. Go to cloud.mongodb.com → your cluster → Connect → Drivers
# 2. Copy the connection string and replace <password> with your DB user password
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=burnoutshield

# ── Docker-only credentials ───────────────────────────────────────
# Only needed when running docker-compose locally.
# Railway and Atlas do not use these.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=BurnoutShield@2026

# ── Server ────────────────────────────────────────────────────────
# Railway sets PORT automatically — leave blank or omit on Railway.
PORT=8000
# development | production
ENV=production

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000
# After deploying frontend to Vercel, update to:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
